{
  "schema": 1,
  "environment": "example",
  "ccp_url": "https://ccp.example.com",
  "enduser": {
    "name": "psmp-health-user",
    "ccp": { "app_id": "PSMP-HealthTest", "safe": "PSMP-HealthTest-Safe", "object": "psmp-health-user" }
  },
  "defaults": { "psmp_server": "psmp01.example.com", "psmp_port": 22 },
  "test": { "hold_seconds": 60, "reason": "automated psmp health test", "passcode_answer": "1", "mfa_wait_sec": 60 },
  "reliability": { "retries": 1, "retry_wait_sec": 30 },
  "prechecks": { "enabled": true },
  "outputs": { "screenshots": "all" },
  "mail": {
    "smtp_host": "mail.example.com", "smtp_port": 25, "from": "psmphealth@example.com",
    "to": ["ops-alerts@example.com"], "send_on": "failure", "subject_prefix": "[PSMP health]"
  }
}
